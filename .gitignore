# This repo holds source plus the benchmark data itself. Everything below is
# produced by the scripts in it and is NOT tracked:
#
#   python scripts/render_vision.py  -> vision/   (needs binding_probe_repo, see README)
#   bash run_benchmark_ollama.sh     -> results*/, logs/
#
# benchmark/ and requests/ ARE tracked, even though generate_benchmark.py and
# prepare_requests.py produce them: they are the frozen v4-final release that
# every reported number is scored against, so they are data, not build output.

# Rule tables regenerated alongside benchmark/ (python generate_benchmark.py)
BASE_RULES_25.md
BASE_RULES_25.csv
BASE_RULES_25.json

# Generated vision stimuli (images, VLM requests, per-object ground truth)
vision/

# Worked examples / reference predictions
examples/

# Built slide deck
slides/

# Model run outputs
results/
results_temp0/
results_qwen3_fixed/
logs/

# Python
__pycache__/
*.py[cod]

# Local editor / agent settings
.claude/
