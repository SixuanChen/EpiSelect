# This repo holds source plus the benchmark data itself. Everything below is
# produced by the scripts in it and is NOT tracked:
#
#   python scripts/render_vision.py  -> vision/   (needs binding_probe_repo, see README)
#   bash run_benchmark_ollama.sh     -> results*/, logs/
#
# benchmark/ and requests/ ARE tracked, even though generate_benchmark.py and
# prepare_requests.py produce them: they are the frozen v4-final release that
# every reported number is scored against, so they are data, not build output.

# Rule tables regenerated alongside benchmark/ (python generate_benchmark.py)
BASE_RULES_25.md
BASE_RULES_25.csv
BASE_RULES_25.json

# Generated vision stimuli. The PNGs, per-object ground truth and labels are
# rebuilt exactly by scripts/render_vision.py, so only the two request files are
# tracked -- they carry the prompt text, which should be readable from a clone.
# Note this must be `vision/*`, not `vision/`: git cannot re-include a file
# inside an excluded directory.
vision/*
!vision/all_120_vlm_requests.jsonl
!vision/all_120_perception_requests.jsonl

# Worked examples / reference predictions
examples/

# Built slide deck
slides/

# Model run outputs. A glob, not a list: naming each directory meant every new
# run (results_vision, results_perception, ...) was tracked by accident.
results*/
logs/

# Python
__pycache__/
*.py[cod]

# Local editor / agent settings
.claude/
